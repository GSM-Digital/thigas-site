PAYLOAD_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA
# SQLite (computador e Coolify). Na Vercel use a URL do Postgres: postgres://usuario:senha@host/banco?sslmode=require
DATABASE_URL=file:./.data/thiago-barreto.db
SERVER_URL=http://localhost:3000
SITE_ENV=preview
# Use production apenas no domínio definitivo. Prévia não deve ser indexada.
# Só na Vercel: token do Vercel Blob (as imagens do painel). Preenchido pela integração de Storage.
# BLOB_READ_WRITE_TOKEN=

# Medição (só carrega com SITE_ENV=production). Clarity já tem o projeto do site como padrão.
# CLARITY_ID=yt9tl6z48z
# GTM_ID=GTM-XXXXXXX
# GA_ID=G-XXXXXXXXXX
# GOOGLE_ADS_ID=AW-XXXXXXXXX
# Webhook(s) que o site pode chamar (libera só a origem na CSP): https://hooks.exemplo.com/lead
# WEBHOOK_URL=
# Outras origens a liberar na CSP, separadas por vírgula.
# CSP_EXTRA_CONNECT=
# CSP_EXTRA_FRAME=
# CSP_MODE=report-only
