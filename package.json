{
  "name": "thiago-barreto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "import:prototype": "node scripts/import-prototype.mjs && npm run build:sections",
    "build:sections": "node scripts/build-sections.mjs",
    "build:articles": "node --env-file=.env --import tsx scripts/build-articles.ts",
    "test": "node --test tests/*.test.mjs",
    "test:cms": "node scripts/verify-cms.mjs",
    "test:html": "node scripts/verify-html.mjs",
    "create-admin": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "vercel-build": "node --import tsx scripts/prepare.ts && next build --webpack",
    "prepare:db": "node --env-file=.env --import tsx scripts/prepare.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/db-sqlite": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-vercel-blob": "3.89.0",
    "@payloadcms/translations": "3.89.0",
    "graphql": "^16.11.0",
    "next": "16.3.5",
    "payload": "3.89.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cheerio": "^1.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
